{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pullkit",
  "version": "0.2.0",
  "identifier": "dev.pullkit.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pullkit",
        "width": 1080,
        "height": 620,
        "minWidth": 820,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
